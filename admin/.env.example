# admin console configuration — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; this template is not. Do not put real secrets here.

ORACLE_ENABLED=true
REQUIRE_ORACLE=1
ORACLE_USER=ADMIN
ORACLE_PASSWORD=change-me
ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=(tcps)(port=1522)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<your-atp>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
ORACLE_POOL_MAX=2
ADMIN_PORT=8003

# Fernet key for every encrypted column (settings, bot tokens, fingerprints).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must match ENCRYPTION_KEY in app1's fastapi-oracle-app/.env — this console
# shares that database, and a key of its own writes settings/fingerprint rows
# the app cannot decrypt (InvalidToken on /api/auth/register). _bootstrap loads
# this file before crypto_util opens the key, so this line wins over
# data/secret.key. Repair a mismatch with app1/rekey_encrypted.py.
ENCRYPTION_KEY=

# HeatWave MySQL
MYSQL_HOST=10.0.0.0
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=heatwavesql
MYSQL_POOL_MAX=4
# TLS trust pin for the HeatWave endpoint. Re-fetch when the endpoint rotates
# its certs.
MYSQL_SSL_CA=heatwave-ca.pem

# Admin login
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Node agent bearer token — must match NODE_TOKEN in node-agent's .env.
NODE_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
