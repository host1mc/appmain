# node-agent configuration — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; this template is not. Do not put real secrets here.

# REQUIRED. The bearer token the panel sends as `Authorization: Bearer <token>`.
# create_app() refuses to start if this is empty. Generate a long random value,
# e.g.  python -c "import secrets; print(secrets.token_hex(32))"
# and set the SAME value as NODE_TOKEN in the panel's environment.
NODE_TOKEN=

# Address waitress binds inside the container. 0.0.0.0 is correct here: the
# container's own network namespace is private, and docker-compose controls what
# is actually published to the host via NODE_PUBLISH_ADDRESS below.
NODE_BIND=0.0.0.0

# Port waitress listens on (and the container port compose publishes).
NODE_PORT=8081

# waitress worker threads. Each open panel console holds one for the life of the
# browser tab (the /logs/follow stream blocks in it), so this is roughly the
# ceiling on simultaneous consoles before ordinary routes start queueing.
NODE_THREADS=32

# Seconds any single Docker API call may take (image pulls, stats samples,
# inspects). Without a deadline one hanging registry pins a waitress thread for
# ever, and NODE_THREADS of them starve the agent including /health. The
# dependency install has its own, much longer limit (DCHOST_INSTALL_TIMEOUT).
NODE_DOCKER_TIMEOUT=120

# Where the agent stores each server's files, as <NODE_DATA_ROOT>/<server-uuid>.
# This MUST be a host path that docker-compose bind-mounts at the same path
# (see docker-compose.yml), because the child bot containers are created against
# the host Docker daemon and bind-mount this path — so the value the agent sees
# has to resolve to the same directory on the host.
NODE_DATA_ROOT=/home/ubuntu/dchost

# Host interface docker-compose publishes port 8081 on. 0.0.0.0 exposes it on
# every interface (restrict with a firewall); set it to the backend VPS
# private/VPN address when the panel runs on another machine.
# This port is full control of the host's Docker daemon behind one shared
# bearer token, and the daemon performs no per-server ownership check — so a
# single token leak on a publicly reachable port is host root. It must never be
# reachable from the internet. Loopback is the safe default and is correct when
# the panel runs on this host; widen it only to the specific private address
# the panel reaches this node on, never back to 0.0.0.0.
NODE_PUBLISH_ADDRESS=127.0.0.1

# Ceiling on how many managed containers this node will create. A backstop
# against a caller looping on POST /api/v1/servers, not a capacity plan — at
# 300 MB each, 200 servers is about 60 GB, well past any real node.
NODE_MAX_SERVERS=200

# How many dependency installs may run at the same time. Each one starts a
# container with the same 300 MB limit as a real server, so without this the
# write rate limit alone allowed 60 a minute — about 18 GB. Creates and
# reinstalls beyond this are refused with a 503 the owner can retry, never
# queued: waiting would pin the request's worker thread and starve /health.
NODE_MAX_CONCURRENT_INSTALLS=4

# Per-client-address request ceilings, in requests per minute. Reads are the
# panel's status/log/file polls; writes are everything that touches Docker or
# the disk; auth counts only rejected tokens, so a leaked or guessed token
# cannot be brute-forced at speed.
NODE_RATE_READ=300
NODE_RATE_WRITE=60
NODE_RATE_AUTH=20

# uid:gid the managed containers run as. Their data directory is bind-mounted
# from the host, so running as root inside would create host files owned by
# root that the next container could not rewrite. Set to empty to fall back to
# whatever user the image itself declares.
DCHOST_CONTAINER_USER=1000:1000

# How long a dependency install may run before the agent kills it. Without a
# limit, an npm install waiting on an unreachable registry leaves the server
# stuck reporting "installing", which blocks start and reinstall alike.
DCHOST_INSTALL_TIMEOUT=900

# Container log persistence. Defaults to "none", meaning managed containers keep
# no logs at all and the panel console shows nothing. Set to json-file to get
# the console back; size is bounded by the two settings below.
# DCHOST_LOG_DRIVER=json-file
# DCHOST_LOG_MAX_SIZE=1m
# DCHOST_LOG_MAX_FILES=2

# ── OPTIONAL: HeatWave pending-deletion drain ────────────────────────────────
# When the panel deletes a server while THIS node is offline, the container is
# left running here. The panel records a tombstone in HeatWave, and removal from
# that queue is MANUAL: an admin confirms it in the admin panel, and the panel's
# reconcile sweep is told to skip tombstoned ids, so nothing is deleted
# automatically. This boot drain is the opt-out of that policy — it removes the
# containers this node still hosts from the queue at startup — and is OFF by
# default. Set DRAIN_HEATWAVE_PENDING=1 only when the admin panel cannot reach
# this node but HeatWave can.
#
# SECURITY: filling these in puts read/write HeatWave credentials (and the CA
# PEM) on the node box. That box already holds full Docker-daemon control behind
# NODE_TOKEN, but HeatWave holds the whole fleet's review/config data, so this
# widens the blast radius of a node compromise. Only set it if you accept that,
# and use a DB account scoped as tightly as your setup allows. Each node must
# also be able to reach the HeatWave endpoint — a node with no route to it just
# logs one warning and skips the drain.
#
# Names match the panel's reviews_db so one credential set covers both.
# MYSQL_HOST=            # HeatWave private IP/host. Unset = drain disabled.
# MYSQL_PORT=3306
# MYSQL_USER=admin       # DO NOT reuse admin here. The drain needs only SELECT
                         # + DELETE on ONE table, so give each node a scoped
                         # account and a node compromise cannot touch reviews,
                         # app_config, or anything else in the schema:
                         #   CREATE USER 'dchost_node'@'<node-ip>' IDENTIFIED BY '...';
                         #   GRANT SELECT, DELETE ON dchost.pending_container_deletions
                         #     TO 'dchost_node'@'<node-ip>';
                         # (app1 keeps INSERT/CREATE; the node never needs them.)
# MYSQL_PASSWORD=
# MYSQL_DATABASE=dchost
# MYSQL_SSL_CA=          # REQUIRED when MYSQL_HOST is set: PEM to pin the TLS
                         # chain. No CA => the drain refuses to connect (never
                         # downgrades TLS). Absolute path, or relative to run.py.
