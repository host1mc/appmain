# =========================================================
# Oracle Wallet
# =========================================================
# The live ATP wallet. Matched at any depth: the deployed copy sits at
# fastapi-oracle-app/Wallet_ATP/, and fastapi-oracle-app/.gitignore repeats
# these rules so the wallet stays covered even if this file is replaced.
**/Wallet_ATP/
**/wallet/

# Service account / credentials
credentials.json
service-account.json
firebase-adminsdk*.json
google-credentials.json

