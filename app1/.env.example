# app1 configuration — copy to fastapi-oracle-app/.env (the file asgi_panel.py
# loads) and fill in. .env is gitignored; this template is not.
# Do not put real secrets here.

ORACLE_ENABLED=true
ORACLE_USER=ADMIN
ORACLE_PASSWORD=change-me
# Walletless one-way TLS: full tcps connect descriptor from the ATP tnsnames.ora.
# The ATP must have mutual-TLS set to "not required" in the OCI console.
ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=(tcps)(port=1522)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<your-atp>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Shards via the Oracle Database API for MongoDB (walletless). Password is
# percent-encoded for the URI (@ -> %40). Read by database.py _load_shard_uris().
DB_0=mongodb://ADMIN:change-me%40%40@<ATP-HOST>.adb.<region>.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&authSource=$external&ssl=true&retryWrites=false&loadBalanced=true
DB_1=mongodb://ADMIN:change-me%40%40@<ATP-HOST-1>.adb.<region>.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&authSource=$external&ssl=true&retryWrites=false&loadBalanced=true

# Flask session secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Fernet key for every encrypted column (settings, bot tokens, fingerprints).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# It must be the SAME value in admin/.env — the admin console shares this
# database, and a second key makes rows unreadable (InvalidToken on
# /api/auth/register). rekey_encrypted.py reports and repairs a mismatch.
# On deployed hosts this can instead come from systemd credentials
# (creds.py / $CREDENTIALS_DIRECTORY/encryption_key).
ENCRYPTION_KEY=

CORS_ORIGINS=https://example.com,http://localhost:5000
RATE_LIMIT_PER_MINUTE=60

# ── HeatWave MySQL (reviews/config) ──
MYSQL_HOST=10.0.0.0
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=heatwavesql
MYSQL_POOL_MAX=4
# TLS trust pin for the HeatWave endpoint (CN-only cert, no SAN — see
# reviews_db.py). Re-fetch when the endpoint rotates its certs.
MYSQL_SSL_CA=heatwave-ca.pem

# ── panel settings ──
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PANEL_SECRET_KEY=
PANEL_SECURE_COOKIES=true
# Must match NODE_TOKEN in node-agent's environment.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
NODE_TOKEN=
PANEL_REQUIRE_NODE=true
ALLOW_REGISTRATION=false
MAX_SERVERS_PER_USER=1
# Panel rows live in Oracle (panel_users / panel_servers / panel_activity).
PANEL_STORE=oracle
# Without this every request looks like it came from the load balancer, so the
# login throttle buckets all users under one IP.
PANEL_TRUST_PROXY=true
# Set PANEL_UI_ENABLED=true to mount the panel at /panel.
PANEL_UI_ENABLED=true
# Where a signed-out visitor is handed to for login. Empty means same origin.
PANEL_MAIN_SITE_URL=
# Max panel upload size in bytes (150 MB).
PANEL_MAX_CONTENT_LENGTH=157286400
PANEL_ACTIVITY_ENABLED=false

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Max concurrent sessions per user (1 = single-session, old sessions killed on new login)
MAX_SESSIONS_PER_USER=1
PANEL_PROXY_TIMEOUT=200
