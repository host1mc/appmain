# db_admin configuration — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; this template is not. Do not put real secrets here.

# Oracle SQL (primary database - BOTHOST ATP)
ORACLE_ENABLED=true
ORACLE_USER=ADMIN
ORACLE_PASSWORD=change-me
ORACLE_DSN=(description=(retry_count=20)(retry_delay=3)(address=(protocol=(tcps)(port=1522)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<your-atp>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# Second ATP (BOTHOST1)
ORACLE_DSN_1=(description=(retry_count=20)(retry_delay=3)(address=(protocol=(tcps)(port=1522)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<your-atp-1>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# MongoDB URIs (Oracle Database API for MongoDB). Password is percent-encoded
# for the URI (@ -> %40).
DB_0=mongodb://ADMIN:change-me%40%40@<ATP-HOST>.adb.<region>.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&authSource=$external&ssl=true&retryWrites=false&loadBalanced=true
DB_1=mongodb://ADMIN:change-me%40%40@<ATP-HOST-1>.adb.<region>.oraclecloudapps.com:27017/ADMIN?authMechanism=PLAIN&authSource=$external&ssl=true&retryWrites=false&loadBalanced=true

# HeatWave MySQL
MYSQL_HOST=10.0.0.0
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=heatwavesql
MYSQL_SSL_CA=heatwave-ca.pem

# Flask session secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
DBADMIN_SECRET=
